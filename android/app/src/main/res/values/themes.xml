<?xml version="1.0" encoding="utf-8"?>
<!-- Shared light palette for the native app screens. -->
<resources>
    <style name="Theme.MotoNav" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#155E75</item>
        <item name="colorPrimaryDark">#F3F6F8</item>
        <item name="colorAccent">#155E75</item>
        <item name="android:windowBackground">#F3F6F8</item>
        <item name="android:statusBarColor">#F3F6F8</item>
        <item name="android:navigationBarColor">#F3F6F8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="alertDialogTheme">@style/Theme.MotoNav.Dialog</item>
    </style>

    <style name="Theme.MotoNav.Dialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="colorAccent">#155E75</item>
    </style>
</resources>
